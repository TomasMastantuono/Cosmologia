   "source": [
    "import numpy as np\n",
    "\n",
    "OB = .3\n",
    "OR = 8.24E-5\n",
    "\n",
    "H0 = 2.2E-18 #s-1\n",
    "\n",
    "TR = .3 #eV\n",
    "T0 = 6.6E-4 #eV\n",
    "TEQ = .8 #eV\n",
    "\n",
    "fterm = (T0 / TEQ)**2 / 2 / np.sqrt(OR)\n",
    "sterm = ( (T0 / TR)**(3/2) - (T0 / TEQ)**(3/2)) * 2 / 3 / np.sqrt(OB)\n",
    "tR = (fterm + sterm) / H0\n",
    "print(tR)"
   ]
  }
